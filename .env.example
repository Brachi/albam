# Copy to .env (gitignored - never commit real credentials) and fill in to
# enable the real-Cloudflare-R2-backed tests (see tests/mtfw/r2_config.py):
#   - tests/mtfw/test_arc_fs_r2.py (smoke test for MTFW_FS.from_s3 itself,
#     against the "re5" prefix)
#   - tests/mtfw/test_mod_serialization.py's local round-trip tests, when
#     explicitly requested with --game-dir=<app-id>::r2:// - this is what lets
#     CI run them without a full local game install (see
#     .github/workflows/tests.yml, which sets these from GitHub secrets and
#     passes --game-dir=re5::r2:// directly - credentials never go on the
#     command line)
#
# One shared bucket for every app_id. Each app_id's game root lives under a
# prefix equal to the app_id itself (e.g. re5's game root is
# s3://<bucket>/re5/..., mirroring the real game folder structure from there
# down).

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
