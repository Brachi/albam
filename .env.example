# Copy to .env (gitignored - never commit real credentials) and fill in to
# enable the real-Cloudflare-R2-backed tests (see tests/mtfw/r2_config.py).
# Two ways R2 gets used: tests that hardcode an app_id directly use
# bucket=R2_BUCKET_NAME below with prefix=that app_id; --game-dir instead
# takes an explicit r2://<bucket>/<prefix> (e.g. r2://albam/re5) - a bare
# r2:// is a hard error, not inferred.
#
# One shared bucket for every app_id, each under a prefix equal to its own
# name (e.g. re5's game root is s3://<bucket>/re5/...).

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
