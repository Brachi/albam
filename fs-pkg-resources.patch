Silence pyfilesystem2's pkg_resources deprecation warning.

Every command that imports albam prints this three times before doing
anything - in pytest output, in scripts, and in Blender's console:

    fs/__init__.py:4: UserWarning: pkg_resources is deprecated as an API.

fs 2.4.16 is the latest release, and upstream has not cut one since fixing
this. Two of the three uses are pkg_resources namespace declarations, which
are vestigial: nothing installs a second distribution into the `fs` package,
and PEP 420 implicit namespace packages have been the way to do this since
Python 3.3. The third is a real use - entry-point discovery for third-party
openers - so it is only made lazy rather than removed: it runs when a
Registry is built with load_extern=True, which albam never does, and behaves
exactly as before when something else does.

A `filterwarnings` entry would not do: the warning comes from the import
itself, so it fires wherever albam is imported, not only under pytest.

Apply it to the environment albam runs in:

    patch -p1 -d "$(python -c 'import fs, os; print(os.path.dirname(os.path.dirname(fs.__file__)))')" < fs-pkg-resources.patch

Reinstalling or upgrading `fs` reverts it; re-run the same command. Check
whether it is still needed first - a release after 2.4.16 should not be, and
the patch refuses to apply once upstream has fixed it.

--- a/fs/__init__.py
+++ b/fs/__init__.py
@@ -1,8 +1,6 @@
 """Python filesystem abstraction layer.
 """
 
-__import__("pkg_resources").declare_namespace(__name__)  # type: ignore
-
 from . import path
 from ._fscompat import fsdecode, fsencode
 from ._version import __version__
--- a/fs/opener/__init__.py
+++ b/fs/opener/__init__.py
@@ -2,9 +2,6 @@
 """Open filesystems from a URL.
 """
 
-# Declare fs.opener as a namespace package
-__import__("pkg_resources").declare_namespace(__name__)  # type: ignore
-
 # Import opener modules so that `registry.install` if called on each opener
 from . import appfs, ftpfs, memoryfs, osfs, tarfs, tempfs, zipfs
 
--- a/fs/opener/registry.py
+++ b/fs/opener/registry.py
@@ -8,7 +8,6 @@
 
 import collections
 import contextlib
-import pkg_resources
 
 from ..errors import ResourceReadOnly
 from .base import Opener
@@ -74,6 +73,8 @@
         """`list`: the list of supported protocols."""
         _protocols = list(self._protocols)
         if self.load_extern:
+            import pkg_resources
+
             _protocols.extend(
                 entry_point.name
                 for entry_point in pkg_resources.iter_entry_points("fs.opener")
@@ -102,6 +103,8 @@
         protocol = protocol or self.default_opener
 
         if self.load_extern:
+            import pkg_resources
+
             entry_point = next(
                 pkg_resources.iter_entry_points("fs.opener", protocol), None
             )
